# .env.example
# Copy to .env and fill in your values.
# .env is excluded from git (see .gitignore) — never commit secrets.

# -----------------------------------------------------------------------
# Telegram API credentials
# Obtain at https://my.telegram.org → "API development tools"
# -----------------------------------------------------------------------
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789

# -----------------------------------------------------------------------
# PostgreSQL connection string
# Inside docker-compose the host name is 'postgres'.
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=disable
# -----------------------------------------------------------------------
DATABASE_DSN=postgres://userbot:userbot@postgres:5432/userbot?sslmode=disable
